<?xml version="1.0" encoding="utf-8"?>
<!-- 播放页的次级控制：有边界感，但保持低对比度。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="oval">
            <solid android:color="#14FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</ripple>
