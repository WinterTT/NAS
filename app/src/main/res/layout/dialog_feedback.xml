<?xml version="1.0" encoding="utf-8"?>
<!-- 意见反馈对话框：类型标签 + 描述 + 联系方式 + 可选的设备信息 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="16dp"
        android:paddingEnd="22dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text="@string/feedback_intro"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/feedback_type_label"
            android:textColor="@color/text_faint"
            android:textSize="12sp" />

        <!-- 类型标签：4 个等宽，避免窄屏换行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipFeedbackType0"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selectable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/chip_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipFeedbackType1"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selectable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/chip_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipFeedbackType2"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selectable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/chip_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipFeedbackType3"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selectable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/chip_text"
                android:textSize="12sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etFeedbackDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="top|start"
            android:hint="@string/feedback_hint_detail"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:lineSpacingExtra="3dp"
            android:minLines="4"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_faint"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etFeedbackContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/feedback_hint_contact"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_faint"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/cbFeedbackInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:checked="true"
            android:text="@string/feedback_attach_info"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvFeedbackInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_faint"
            android:textIsSelectable="true"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/feedback_footer"
            android:textColor="@color/text_faint"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
