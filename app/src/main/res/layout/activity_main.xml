<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_start" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/btn_stop" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_clear" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/status_idle"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDeviceTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/device_title"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <!-- 第 7 课 B：首页常驻的"播放队列"入口（没在播放也能看到/点进队列） -->
    <TextView
        android:id="@+id/tvQueueEntry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_now_bar"
        android:drawableStart="@drawable/ic_queue"
        android:drawablePadding="6dp"
        android:drawableTint="@color/now_bar_text"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:text="播放队列"
        android:textColor="@color/now_bar_text"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="gone" />

    <ListView
        android:id="@+id/listDevices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:divider="?android:attr/listDivider"
        android:choiceMode="none" />

    <!-- ===== 第 7 课 A：底部"正在播放"控制条（含进度条） ===== -->
    <LinearLayout
        android:id="@+id/nowPlayingBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_now_bar"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- 第一行：信息 + 控制按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 第 7 课 C：专辑封面缩略图（有封面才显示） -->
            <ImageView
                android:id="@+id/imgNowArt"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="专辑封面"
                android:scaleType="centerCrop"
                android:visibility="gone"
                tools:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNowDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/now_playing_hint"
                    android:textColor="@color/now_bar_subtext"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvNowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/now_bar_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNowVolume"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="2dp"
                        android:drawableStart="@drawable/ic_vol_up"
                        android:drawableTint="@color/now_bar_subtext"
                        android:gravity="center_vertical"
                        android:minHeight="16dp"
                        android:text="--"
                        android:textColor="@color/now_bar_subtext"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 第 7 课 C：歌手 · 专辑 小字（曲库元数据里有才显示） -->
                <TextView
                    android:id="@+id/tvNowMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/now_bar_subtext"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:visibility="gone" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnNowPlayPause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="播放/暂停"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/btnNowStop"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="停止"
                android:src="@drawable/ic_stop" />

            <ImageButton
                android:id="@+id/btnNowVolDown"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="音量减小"
                android:src="@drawable/ic_vol_down" />

            <ImageButton
                android:id="@+id/btnNowVolUp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="音量增大"
                android:src="@drawable/ic_vol_up" />
        </LinearLayout>

        <!-- 第二行：播放进度条 + 时间 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNowTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="42dp"
                android:gravity="center"
                android:text="0:00"
                android:textColor="@color/now_bar_subtext"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/seekNow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000" />

            <TextView
                android:id="@+id/tvNowDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="42dp"
                android:gravity="center"
                android:text="0:00"
                android:textColor="@color/now_bar_subtext"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 第三行：第 7 课 B 播放队列（上一首 / 下一首 + 队列入口） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnNowPrev"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="上一首"
                android:src="@drawable/ic_prev" />

            <ImageButton
                android:id="@+id/btnNowNext"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="下一首"
                android:src="@drawable/ic_next" />

            <TextView
                android:id="@+id/tvNowQueue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="?android:attr/selectableItemBackground"
                android:text="队列(0)"
                android:textColor="@color/now_bar_text"
                android:textSize="12sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_queue"
                android:drawablePadding="4dp"
                android:drawableTint="@color/now_bar_subtext"
                android:gravity="center_vertical"
                android:text="@string/queue_bar_hint"
                android:textColor="@color/now_bar_subtext"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
