<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- ================= 顶栏：标题 + 扫描开关 ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStart"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_primary"
            android:minWidth="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:stateListAnimator="@null"
            android:text="@string/btn_start"
            android:textAllCaps="false"
            android:textColor="@color/on_brand"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStop"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_ghost"
            android:minWidth="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:stateListAnimator="@null"
            android:text="@string/btn_stop"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- 状态行（空闲/扫描中/Wi-Fi 断开等文案） -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:text="@string/status_idle"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- ================ 正在播放 · 大卡（有播放会话才出现） ================ -->
    <LinearLayout
        android:id="@+id/nowPlayingBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_now_bar"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- 第一行：大封面 + 曲目信息 + 队列入口 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgNowArt"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_art_round"
                android:clipToOutline="true"
                android:contentDescription="专辑封面"
                android:outlineProvider="background"
                android:scaleType="centerCrop"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/now_playing_hint"
                    android:textColor="@color/now_bar_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- 歌手 · 专辑 -->
                <TextView
                    android:id="@+id/tvNowMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/now_bar_subtext"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- 播放在哪台设备 + 音量 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvNowDevice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/now_bar_subtext"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvNowVolume"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="3dp"
                        android:drawableStart="@drawable/ic_vol_up"
                        android:drawableTint="@color/now_bar_subtext"
                        android:gravity="center_vertical"
                        android:minHeight="16dp"
                        android:text="--"
                        android:textColor="@color/now_bar_subtext"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvNowQueue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_ghost"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="队列(0)"
                android:textColor="@color/now_bar_text"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 第二行：进度条 + 时间 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNowTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="38dp"
                android:gravity="center"
                android:text="0:00"
                android:textColor="@color/now_bar_subtext"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekNow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:progressTint="@color/brand"
                android:thumbTint="@color/brand" />

            <TextView
                android:id="@+id/tvNowDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="38dp"
                android:gravity="center"
                android:text="0:00"
                android:textColor="@color/now_bar_subtext"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 第三行：播放控制（主按钮品牌色圆形） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnNowPrev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="上一首"
                android:src="@drawable/ic_prev"
                android:tint="@color/now_bar_text" />

            <ImageButton
                android:id="@+id/btnNowPlayPause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_circle_brand"
                android:contentDescription="播放/暂停"
                android:src="@drawable/ic_play"
                android:tint="@color/on_brand" />

            <ImageButton
                android:id="@+id/btnNowNext"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="下一首"
                android:src="@drawable/ic_next"
                android:tint="@color/now_bar_text" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnNowStop"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="停止"
                android:src="@drawable/ic_stop"
                android:tint="@color/now_bar_subtext" />

            <ImageButton
                android:id="@+id/btnNowVolDown"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="音量减小"
                android:src="@drawable/ic_vol_down"
                android:tint="@color/now_bar_subtext" />

            <ImageButton
                android:id="@+id/btnNowVolUp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="音量增大"
                android:src="@drawable/ic_vol_up"
                android:tint="@color/now_bar_subtext" />
        </LinearLayout>
    </LinearLayout>

    <!-- ================= 设备区标题 + 清空 ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDeviceTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/device_title"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_pill_ghost"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:stateListAnimator="@null"
            android:text="@string/btn_clear"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 首页常驻的"播放队列"入口（没在播放也能点进队列） -->
    <TextView
        android:id="@+id/tvQueueEntry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_row_card"
        android:drawableStart="@drawable/ic_queue"
        android:drawablePadding="6dp"
        android:drawableTint="@color/now_bar_text"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="播放队列"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="gone" />

    <!-- ================= 设备列表（卡片行 + 空态文案） ================= -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listDevices"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_faint"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="还没有发现设备\n点右上角「开始扫描」" />
    </FrameLayout>
</LinearLayout>
